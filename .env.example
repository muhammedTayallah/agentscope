# Copy to .env and fill in. Never commit .env.

# Postgres (docker-compose builds DATABASE_URL from these)
POSTGRES_USER=agentscope
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agentscope

# Used when running the backend outside Docker
DATABASE_URL=postgresql+asyncpg://agentscope:change-me@127.0.0.1:5432/agentscope
REDIS_URL=redis://127.0.0.1:6379/0

# Bearer token for the project/API-key management API. Empty = management disabled.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=change-me

# JSON list of allowed browser origins
CORS_ORIGINS=["http://localhost:5180"]

# Integration tests (the tests wipe these; use separate databases)
TEST_DATABASE_URL=postgresql+asyncpg://agentscope:change-me@127.0.0.1:5432/agentscope_test
TEST_REDIS_URL=redis://127.0.0.1:6379/15
