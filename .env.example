# Copy to .env and fill in. Never commit .env.

# Postgres (docker-compose builds DATABASE_URL from these)
POSTGRES_USER=agentscope
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agentscope

# Used when running the backend outside Docker
DATABASE_URL=postgresql+asyncpg://agentscope:change-me@127.0.0.1:5432/agentscope
REDIS_URL=redis://127.0.0.1:6379/0

# Bearer token for the project/API-key management API. Empty = management disabled.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=change-me

# JSON list of allowed browser origins
CORS_ORIGINS=["http://localhost:5180"]

# Integration tests (the tests wipe these; use separate databases)
TEST_DATABASE_URL=postgresql+asyncpg://agentscope:change-me@127.0.0.1:5432/agentscope_test
TEST_REDIS_URL=redis://127.0.0.1:6379/15

# Model prices for cost metrics, USD per 1M tokens: {"model": [input, output]}.
# Anthropic models have built-in defaults; add Gemini and others here.
# Gemini 3.8 Flash and 3.6 Flash: $0.75 in / $3.75 out (incl. thinking) through 2026-12-31,
# $1.50 / $7.50 from 2027-01-01. Gemini 3.5 Flash-Lite: $0.30 / $2.50 (ai.google.dev pricing page).
MODEL_PRICES={"gemini-3.8-flash": [0.75, 3.75], "gemini-3.6-flash": [0.75, 3.75], "gemini-3.5-flash-lite": [0.30, 2.50]}

# Demo agent in evals/ (Phase 5): its LLM key, and a project key to trace into
GEMINI_API_KEY=your-gemini-key
AGENTSCOPE_API_KEY=ask_...
AGENTSCOPE_HOST=http://localhost:8000

# LLM-as-judge for eval runs (worker). Provider: gemini | anthropic; empty model = provider default
# (gemini-3.8-flash / claude-opus-5-5). Uses GEMINI_API_KEY or ANTHROPIC_API_KEY.
JUDGE_PROVIDER=gemini
JUDGE_MODEL=gemini-3.5-flash-lite
ANTHROPIC_API_KEY=

# Production: serve the built UI from this directory at / (the API moves to /api), and run
# the ARQ worker inside the web process (hosts without a separate worker service).
STATIC_DIR=
RUN_WORKER=false
